# Ollama / Llama (origem HF: meta-llama/Meta-Llama-3.1-8B-Instruct)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.3

# Reengajamento de leads (dias sem interação)
REENGAGEMENT_DAYS=3

# E-mail: mock grava em data/outbox/ | smtp envia de verdade
EMAIL_MODE=mock
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=imobiliaria@exemplo.com
SMTP_USE_TLS=true

# Caminhos (relativos à raiz do projeto)
DATA_DIR=data
CHROMA_DIR=data/chroma
DB_PATH=data/app.db
OUTBOX_DIR=data/outbox
